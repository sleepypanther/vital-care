{
  "name": "healthcare-platform",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @healthcare/db generate",
    "db:migrate": "pnpm --filter @healthcare/db migrate",
    "db:push": "pnpm --filter @healthcare/db push",
    "db:studio": "pnpm --filter @healthcare/db studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
